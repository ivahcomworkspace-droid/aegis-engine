# Copy this file to .env (git ignores it) or set the same variables in the environment.

# Required for live data. The SEC asks automated clients to identify themselves:
# a name or company followed by a contact email.
AEGIS_SEC_USER_AGENT="Your Company you@yourcompany.com"

# Optional. Price feed for equity value and volatility. Default: yahoo (free, unofficial).
# AEGIS_PRICE_PROVIDER=yahoo

# Optional. Where downloads are cached. Default: .cache/market inside the project.
# AEGIS_CACHE_DIR=/var/cache/aegis
